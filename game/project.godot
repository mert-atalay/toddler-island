; Engine configuration file.
; Toddler Island, rebuilt in Godot (see the rebuild plan doc). Step 1: the art lineup.

config_version=5

[application]

config/name="Toddler Island"
config/description="A gentle animal island for a two-year-old and the parent who steers."
run/main_scene="res://corner/corner.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[audio]

driver/enable_input=true

general/text_to_speech=true

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[rendering]

mesh_lod/lod_change/threshold_pixels=3.0

anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3

[shader_globals]

cloud_offset={
"type": "vec2",
"value": Vector2(0, 0)
}
player_pos={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
